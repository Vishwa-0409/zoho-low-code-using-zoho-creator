		workflow
		{
		form
		{
			auto_update_available_copies as "Auto-Update Available Copies"
			{
				type =  form
				form = book_issues

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the book_issues record to get the book names
										bookIssueRecord = book_issues[ID == input.ID];
										// Get the list of book names from the multi_select_lookup field
										bookNames = bookIssueRecord.book_name;
										// Iterate through each book name to update available copies
										for each  bookName in bookNames
										{
											// Fetch the book record by ID from the lookup field
											bookRecord = books[ID == bookName];
											// Check if the book record exists
											if(!bookRecord.isNull())
											{
												// Decrease the available copies by 1
												bookRecord.available_copies=bookRecord.available_copies - 1;
											}
										}
						)
					}
				}

			}
			validate_overdue_status as "Validate Overdue Status"
			{
				type =  form
				form = book_issues

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if due_date field exists and is not null
										if(input.due_date.isNull())
										{
											alert "Due date is required. Please provide a valid due date.";
											cancel submit;
										}
										// Get the current date for comparison
										currentDate = zoho.currentdate;
										// Check if due date is in the past
										if(input.due_date < currentDate)
										{
											alert "Submission cancelled: Due date cannot be in the past. Please provide a future date.";
											cancel submit;
										}
						)
					}
				}

			}
		}

		schedule
		{
			notify_member_overdue as "Notify Member of Overdue"
			{
				type =  schedule
				form = book_issues
					status = inactive
				start = due_date at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Check if the return status is Overdue
										if(input.return_status == "Overdue")
										{
											// Get the member email from the current record
											memberEmail = input.member_email;
											// Get the book name (multi_select_lookup - iterate to get titles)
											bookTitles = "";
											for each  bookRecord in input.book_name
											{
												if(isBlank(bookTitles))
												{
													bookTitles = bookRecord.book_title;
												}
												else
												{
													bookTitles = bookTitles.concat(", ").concat(bookRecord.book_title);
												}
											}
											// Get the due date
											dueDate = input.due_date;
											// Get the member name
											memberName = input.member_name;
											// Construct email message
											subject = "Overdue Book Return Alert";
											message = "Dear " + memberName + ",\n\n";
											message = message.concat("Your book(s) are overdue for return.\n");
											message = message.concat("Book(s): " + bookTitles + "\n");
											message = message.concat("Due Date: " + dueDate.toText("dd-MMM-yyyy") + "\n\n");
											message = message.concat("Please return the book(s) as soon as possible to avoid further penalties.\n\n");
											message = message.concat("Thank you,\nLibrary Team");
											// Send email to the member
											sendmail
											[
												from :zoho.loginuserid
												to :memberEmail
												subject :subject
												message :message
												content type :Plain Text
											]
										}
					)
					}
				}
			}
		}


