	web
	{
		forms
		{
			form book_issues
			{
				label placement = left
			}
			form books
			{
				label placement = left
			}
		}
		reports
		{
			report book_issues_Report
			{
				quickview
				(
					layout
					(
						datablock1
						(
							fields
							(
								member_name as "Member Name"
								member_email as "Member Email"
								book_name as "Book Name"
								issue_date as "Issue Date"
								due_date as "Due Date"
								return_status as "Return Status"
								issue_location as "Issue Location"
								renewal_count as "Renewal Count"
								notes as "Notes"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
								Print 
								Add 
								Import 
								Export 
							)
						record
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
							Print   	   
    					)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
							Print   	   
							View Record   	   
